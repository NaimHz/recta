{
  "name": "@recta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:check": "tsx src/db/check.ts",
    "verify": "tsx src/cli/verify.ts",
    "extract": "tsx src/cli/extract.ts",
    "data:check": "tsx src/cli/check-data.ts",
    "osm:fetch": "tsx src/sources/osm/fetch-places.ts",
    "eval:resolution": "tsx src/evals/resolution.ts",
    "eval:agent": "tsx src/evals/resolution-agent.ts",
    "eval:opening-hours": "tsx src/evals/opening-hours.ts",
    "eval:verification": "tsx src/evals/verification.ts",
    "eval:extraction": "tsx src/evals/extraction.ts",
    "eval:extraction:live": "tsx src/evals/extraction.ts --live",
    "eval:extraction-f1": "tsx src/evals/extraction-f1.ts",
    "eval:extraction-f1:live": "tsx src/evals/extraction-f1.ts --live"
  },
  "dependencies": {
    "@recta/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "opening_hours": "3.15.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
