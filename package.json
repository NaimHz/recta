{
  "name": "recta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @recta/web dev",
    "dev:api": "pnpm --filter @recta/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @recta/api db:generate",
    "db:migrate": "pnpm --filter @recta/api db:migrate",
    "db:seed": "pnpm --filter @recta/api db:seed",
    "db:reset": "pnpm --filter @recta/api db:reset",
    "db:check": "pnpm --filter @recta/api db:check",
    "verify": "pnpm --filter @recta/api verify",
    "extract": "pnpm --filter @recta/api extract",
    "data:check": "pnpm --filter @recta/api data:check",
    "osm:fetch": "pnpm --filter @recta/api osm:fetch",
    "eval:resolution": "pnpm --filter @recta/api eval:resolution",
    "eval:agent": "pnpm --filter @recta/api eval:agent",
    "eval:opening-hours": "pnpm --filter @recta/api eval:opening-hours",
    "eval:verification": "pnpm --filter @recta/api eval:verification",
    "eval:extraction": "pnpm --filter @recta/api eval:extraction",
    "eval:extraction:live": "pnpm --filter @recta/api eval:extraction:live"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
